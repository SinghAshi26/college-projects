# Copy to .env for local development. Never commit real values.
# Supabase Connect > Session pooler (IPv4), using a dedicated backend login.
SUPABASE_DB_URL=postgresql://appnix_app.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
SUPABASE_SSL_ROOT_CERT="C:/path/to/database-ca.crt"
APP_PASSWORD=replace-with-a-long-random-password
GOOGLE_API_KEY=replace-with-your-server-api-key
PSI_API_KEY=
# Used only to initialize settings, thereafter change saved limits in the app.
# 900 preserves the previous monthly default; it is NOT a free-tier guarantee.
SEARCH_MONTHLY_LIMIT=900
# Set an explicit daily maximum before enabling searches. 0 blocks searches.
SEARCH_DAILY_LIMIT=0
